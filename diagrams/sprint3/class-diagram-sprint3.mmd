classDiagram
    %% ============================================
    %% Sprint 3: Request Management & Shortlisting
    %% Duration: 26 Oct 2025 - 02 Nov 2025
    %% User Stories: #15, #16, #17, #18, #19, #20, #21, #26, #27, #28
    %% ============================================

    %% ============================================
    %% ENUMS
    %% ============================================
    
    class UserStatus {
        <<enumeration>>
        ACTIVE
        SUSPENDED
        DELETED
    }

    class ProfileStatus {
        <<enumeration>>
        ACTIVE
        SUSPENDED
        DEACTIVATED
    }

    class RequestStatus {
        <<enumeration>>
        ACTIVE
        MATCHED
        COMPLETED
        CANCELLED
    }

    class UrgencyLevel {
        <<enumeration>>
        LOW
        MEDIUM
        HIGH
    }

    %% ============================================
    %% CORE ENTITIES
    %% ============================================

    class UserAccount {
        -UUID id
        -String email
        -String password
        -String name
        -String phoneNumber
        -String address
        -Date dateOfBirth
        -UserStatus status
        -UUID userProfileId
        -DateTime createdAt
        -DateTime updatedAt
        -Integer age
        -String location
        -String accessibilityNeeds
        -String profilePhoto
        -String companyName
        -String companyRegistrationNumber
        -String industry
        -String contactPerson
        -String companyAddress
        -String companyLogo
        -String department
        -ProfileStatus profileStatus
        +getRole() String
        +toJSON() Object
        +findAll(page, limit)$ UserAccount[]
        +findById(id)$ UserAccount
        +findByEmail(email)$ UserAccount
        +login(email, password)$ LoginResult
        +findByProfileName(name)$ UserAccount[]
        +create(data)$ UserAccount
        +update(id, data)$ UserAccount
        +count()$ Number
        +search(query, page, limit)$ UserAccount[]
    }

    class UserProfile {
        -UUID id
        -String name
        -String description
        -JSON permissions
        -Boolean isActive
        -DateTime createdAt
        -DateTime updatedAt
        +findAll()$ UserProfile[]
        +findById(id)$ UserProfile
        +findByName(name)$ UserProfile
        +create(data)$ UserProfile
        +update(id, data)$ UserProfile
        +count()$ Number
        +search(query, isActive)$ UserProfile[]
    }

    class RequestCategory {
        -UUID id
        -String name
        -String description
        -String iconUrl
        -Boolean isActive
        -DateTime createdAt
        -DateTime updatedAt
        +findAll()$ RequestCategory[]
        +findActive()$ RequestCategory[]
        +findById(id)$ RequestCategory
        +create(data)$ RequestCategory
        +update(id, data)$ RequestCategory
        +delete(id)$ Boolean
        +search(query, includeInactive)$ RequestCategory[]
        +count()$ Number
    }

    %% ============================================
    %% REQUEST MANAGEMENT (New in Sprint 3)
    %% ============================================

    class Request {
        -UUID id
        -UUID pinId
        -UUID categoryId
        -String title
        -String description
        -UrgencyLevel urgency
        -DateTime dateNeeded
        -String location
        -RequestStatus status
        -Integer viewCount
        -Integer shortlistCount
        -DateTime createdAt
        -DateTime updatedAt
        +toJSON() Object
        +findById(id)$ Request
        +searchByPIN(pinId, query, status, categoryId, urgency)$ Request[]
        +findByStatus(status, page, limit)$ Request[]
        +findCompletedByPIN(pinId, query)$ Request[]
        +create(data)$ Request
        +update(id, data)$ Request
        +delete(id)$ Boolean
        +count()$ Number
        +countByStatus(status)$ Number
        +search(query, status, urgency, categoryId, page, limit)$ Request[]
        +incrementViewCountDB(id)$ void
        +incrementShortlistCountDB(id)$ void
        +getViewCount(pinId, requestId)$ Number
        +getShortlistCount(pinId, requestId)$ Number
    }

    class Shortlist {
        -UUID id
        -UUID csrRepId
        -UUID requestId
        -DateTime createdAt
        +findById(id)$ Shortlist
        +getShortlistedRequestIds(csrRepId)$ String[]
        +create(data)$ Shortlist
        +deleteByCSRRepAndRequest(csrRepId, requestId)$ Boolean
        +exists(csrRepId, requestId)$ Boolean
        +search(csrRepId, query)$ Shortlist[]
    }

