classDiagram
    %% ============================================
    %% Sprint 3: Request Management & Shortlisting
    %% Duration: 26 Oct 2025 - 02 Nov 2025
    %% User Stories: #15, #16, #17, #18, #19, #20, #21, #26, #27, #28
    %% ============================================

    %% ============================================
    %% ENUMS
    %% ============================================
    
    class UserStatus {
        <<enumeration>>
        ACTIVE
        SUSPENDED
        DELETED
    }

    class ProfileStatus {
        <<enumeration>>
        ACTIVE
        SUSPENDED
        DEACTIVATED
    }

    class RequestStatus {
        <<enumeration>>
        ACTIVE
        MATCHED
        COMPLETED
        CANCELLED
    }

    class UrgencyLevel {
        <<enumeration>>
        LOW
        MEDIUM
        HIGH
    }

    %% ============================================
    %% CORE ENTITIES
    %% ============================================

    class UserAccount {
        -UUID id
        -String email
        -String password
        -String name
        -String phoneNumber
        -String address
        -Date dateOfBirth
        -UserStatus status
        -UUID userProfileId
        -DateTime createdAt
        -DateTime updatedAt
        -Integer age
        -String location
        -String accessibilityNeeds
        -String profilePhoto
        -String companyName
        -String companyRegistrationNumber
        -String industry
        -String contactPerson
        -String companyAddress
        -String companyLogo
        -String department
        -ProfileStatus profileStatus
        +isActive() Boolean
        +isSuspended() Boolean
        +isPIN() Boolean
        +isCSRRep() Boolean
        +findById(id)$ UserAccount
        +findByEmail(email)$ UserAccount
        +create(data)$ UserAccount
        +update(id, data)$ UserAccount
    }

    class UserProfile {
        -UUID id
        -String name
        -String description
        -JSON permissions
        -Boolean isActive
        -DateTime createdAt
        -DateTime updatedAt
        +hasPermission(permission) Boolean
        +isActiveRole() Boolean
        +findByName(name)$ UserProfile
        +getAllProfiles()$ UserProfile[]
    }

    class RequestCategory {
        -UUID id
        -String name
        -String description
        -String iconUrl
        -Boolean isActive
        -DateTime createdAt
        -DateTime updatedAt
        +isActive() Boolean
        +findById(id)$ RequestCategory
        +findAll()$ RequestCategory[]
        +create(data)$ RequestCategory
        +update(id, data)$ RequestCategory
    }

    %% ============================================
    %% REQUEST MANAGEMENT (New in Sprint 3)
    %% ============================================

    class Request {
        -UUID id
        -UUID pinId
        -UUID categoryId
        -String title
        -String description
        -UrgencyLevel urgency
        -DateTime dateNeeded
        -String location
        -RequestStatus status
        -Integer viewCount
        -Integer shortlistCount
        -DateTime createdAt
        -DateTime updatedAt
        +isActive() Boolean
        +isMatched() Boolean
        +isCompleted() Boolean
        +isUrgent() Boolean
        +incrementViewCount() void
        +incrementShortlistCount() void
        +decrementShortlistCount() void
        +findById(id)$ Request
        +findByPIN(pinId)$ Request[]
        +search(query, filters)$ Request[]
        +create(data)$ Request
        +update(id, data)$ Request
        +delete(id)$ Boolean
    }

    class Shortlist {
        -UUID id
        -UUID csrRepId
        -UUID requestId
        -DateTime createdAt
        +getAgeInDays() Integer
        +isRecent() Boolean
        +findById(id)$ Shortlist
        +create(data)$ Shortlist
        +delete(id)$ Boolean
    }

    note for UserProfile "Only 4 static records exist:\nPIN, CSR_REP, USER_ADMIN, PLATFORM_MANAGER"
    note for UserAccount "Single Table Inheritance Pattern:\n- All role-specific fields in ONE class\n- Role determined by userProfile reference"

    %% ============================================
    %% RELATIONSHIPS
    %% ============================================
    
    %% Core relationships from previous sprints
    UserProfile "1" --> "0..*" UserAccount : has role
    UserAccount --> UserStatus : has status
    UserAccount --> ProfileStatus : has profile status

    %% Request relationships (New in Sprint 3)
    RequestCategory "1" --> "0..*" Request : categorizes
    UserAccount "1" --> "0..*" Request : creates (PIN role)
    Request --> RequestStatus : has status
    Request --> UrgencyLevel : has urgency

    %% Shortlist relationships (New in Sprint 3)
    UserAccount "1" --> "0..*" Shortlist : saves (CSR role)
    Request "1" --> "0..*" Shortlist : saved by
