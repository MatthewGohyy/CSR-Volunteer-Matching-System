classDiagram
    %% ============================================
    %% Sprint 1: Authentication & Basic User/Profile Management
    %% Duration: 09 Oct 2025 - 19 Oct 2025
    %% User Stories: #1, #2, #3, #6, #8, #11, #13, #14, #24, #25, #33, #34
    %% ============================================

    %% ============================================
    %% ENUMS
    %% ============================================
    
    class UserStatus {
        <<enumeration>>
        ACTIVE
        SUSPENDED
        DELETED
    }

    class ProfileStatus {
        <<enumeration>>
        ACTIVE
        SUSPENDED
        DEACTIVATED
    }

    %% ============================================
    %% CORE AUTHENTICATION & AUTHORIZATION
    %% ============================================

    class UserAccount {
        -UUID id
        -String email
        -String password
        -String name
        -String phoneNumber
        -String address
        -Date dateOfBirth
        -UserStatus status
        -UUID userProfileId
        -DateTime createdAt
        -DateTime updatedAt
        -Integer age
        -String location
        -String accessibilityNeeds
        -String profilePhoto
        -String companyName
        -String companyRegistrationNumber
        -String industry
        -String contactPerson
        -String companyAddress
        -String companyLogo
        -String department
        -ProfileStatus profileStatus
        +isActive() Boolean
        +getRole() String
        +toJSON() Object
        +findAll(page, limit)$ UserAccount[]
        +findById(id)$ UserAccount
        +findByEmail(email)$ UserAccount
        +login(email, password)$ LoginResult
        +findByProfileName(name)$ UserAccount[]
        +create(data)$ UserAccount
        +update(id, data)$ UserAccount
        +suspend(id)$ UserAccount
        +activate(id)$ UserAccount
        +count()$ Number
        +search(query, page, limit)$ UserAccount[]
    }

    class UserProfile {
        -UUID id
        -String name
        -String description
        -JSON permissions
        -Boolean isActive
        -DateTime createdAt
        -DateTime updatedAt
        +findAll()$ UserProfile[]
        +findById(id)$ UserProfile
        +findByName(name)$ UserProfile
        +findActive()$ UserProfile[]
        +create(data)$ UserProfile
        +update(id, data)$ UserProfile
        +count()$ Number
        +search(query, isActive)$ UserProfile[]
    }

    note for UserProfile "Only 4 static records exist:\nPIN, CSR_REP, USER_ADMIN, PLATFORM_MANAGER"
    note for UserAccount "Single Table Inheritance Pattern:\n- All role-specific fields in ONE class\n- Role determined by userProfile reference\n- PIN users use: age, location, accessibilityNeeds\n- CSR users use: companyName, companyRegistrationNumber, etc\n- Platform Managers use: department\n- Unused fields are NULL for each user"

    %% ============================================
    %% RELATIONSHIPS
    %% ============================================
    
    UserProfile "1" --> "0..*" UserAccount : has role
    UserAccount --> UserStatus : has status
    UserAccount --> ProfileStatus : has profile status
