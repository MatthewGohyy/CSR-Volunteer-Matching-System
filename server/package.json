{
  "name": "csr-volunteer-matching-server",
  "version": "1.0.0",
  "description": "Backend server for CSR Volunteer Matching System",
  "main": "dist/index.js",
  "scripts": {
    "build": "tsc",
    "start": "node dist/index.js",
    "dev": "nodemon --exec ts-node -r tsconfig-paths/register src/server.ts",
    "dev:watch": "nodemon --watch src --exec ts-node -r tsconfig-paths/register src/server.ts",
    "seed": "ts-node prisma/seed.ts",
    "seed:large": "ts-node prisma/seeders/generate-large-dataset.ts",
    "seed:reset": "npx prisma migrate reset --force && npm run seed:large",
    "test": "jest",
    "test:watch": "jest --watch",
    "test:sprint1": "jest tests/sprint1.test.ts --verbose",
    "test:sprint1:watch": "jest tests/sprint1.test.ts --watch",
    "test:sprint1:coverage": "jest tests/sprint1.test.ts --coverage --verbose",
    "lint": "eslint src/**/*.ts",
    "lint:fix": "eslint src/**/*.ts --fix",
    "type-check": "tsc --noEmit",
    "clean": "rm -rf dist"
  },
  "prisma": {
    "seed": "ts-node prisma/seed.ts"
  },
  "dependencies": {
    "@prisma/client": "^5.22.0",
    "bcryptjs": "^2.4.3",
    "compression": "^1.7.4",
    "cors": "^2.8.5",
    "dotenv": "^16.3.1",
    "express": "^4.18.2",
    "express-rate-limit": "^7.1.5",
    "express-validator": "^7.0.1",
    "helmet": "^7.1.0",
    "jsonwebtoken": "^9.0.2",
    "morgan": "^1.10.0",
    "multer": "^1.4.5-lts.1"
  },
  "devDependencies": {
    "@eslint/js": "^9.0.0",
    "@faker-js/faker": "^10.1.0",
    "@types/bcryptjs": "^2.4.6",
    "@types/compression": "^1.8.1",
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.3",
    "@types/helmet": "^0.0.48",
    "@types/jest": "^30.0.0",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/morgan": "^1.9.10",
    "@types/multer": "^2.0.0",
    "@types/node": "^24.6.2",
    "@types/supertest": "^6.0.3",
    "eslint": "^8.55.0",
    "jest": "^29.7.0",
    "nodemon": "^3.1.10",
    "prisma": "^5.22.0",
    "supertest": "^6.3.4",
    "ts-jest": "^29.4.5",
    "ts-node": "^10.9.2",
    "tsconfig-paths": "^4.2.0",
    "typescript": "^5.9.3"
  },
  "keywords": [
    "express",
    "postgresql",
    "prisma",
    "api",
    "volunteer",
    "csr"
  ],
  "author": "CSIT314 Group Project",
  "license": "MIT"
}
