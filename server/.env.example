# Environment Variables for CSR Volunteer Matching System Server

# Database Configuration (PostgreSQL with Docker)
DATABASE_URL="postgresql://dev:dev123@localhost:5432/csr_platform"

# JWT Configuration
JWT_SECRET=your_super_secret_jwt_key_min_32_chars_change_in_production
JWT_EXPIRES_IN=7d

# Server Configuration
NODE_ENV=development
PORT=4000

# Frontend URL (for CORS)
FRONTEND_URL=http://localhost:5173
