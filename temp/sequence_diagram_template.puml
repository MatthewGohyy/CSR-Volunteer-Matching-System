@startuml
title Sequence Diagram - User Admin Login

'====================================
' General Layout and Styling
'====================================
skinparam backgroundColor white
skinparam shadowing false
skinparam actorStyle awesome
skinparam rectangle {
  BackgroundColor white
  BorderColor black
}

'====================================
' Define Participants
'====================================
actor "User Admin" as A
boundary "LoginPage" as B
control "AuthController" as C
entity "User" as E

'====================================
' Normal Flow
'====================================
== Normal Flow ==
A -> B: Enter credentials (email, password)
activate B
B -> B: validateForm()
B -> C: handleSubmit(e: React.FormEvent)
activate C
C -> E: login(req: Request, res: Response, next: NextFunction)
activate E
E --> C: return json
deactivate E
C --> B: onSuccess(data)
deactivate C
B --> A: Redirect to Admin Dashboard
deactivate B

'====================================
' Alternative / Exceptional Flow
'====================================
== Alternate / Exception Flow: Invalid Credentials ==
A -> B: Enter credentials (email, password)
activate B
B -> B: validateForm()
B -> C: handleSubmit(e: React.FormEvent)
activate C
C -> E: login(req: Request, res: Response, next: NextFunction)
activate E
E --> C: return error: AppError
deactivate E
C --> B: onError(error: any)
deactivate C
B --> A: Display error message and prompt re-entry
deactivate B
@enduml