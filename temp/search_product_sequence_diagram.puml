@startuml
title Sequence Diagram - Customer Search Product

'====================================
' General Layout and Styling
'====================================
skinparam backgroundColor white
skinparam shadowing false
skinparam actorStyle awesome
skinparam rectangle {
  BackgroundColor white
  BorderColor black
}

'====================================
' Define Participants
'====================================
actor "Customer" as A
boundary "SearchProductPage" as B
control "SearchProductController" as C
entity "Product" as E

'====================================
' Normal Flow
'====================================
== Normal Flow ==
A -> B: Enter search query (query: string)
activate B
B -> C: searchProduct(query: string): Product[]
activate C
C -> E: searchProduct(query: string): Product[]
activate E
E --> C: return Product[]
deactivate E
C --> B: return Product[]
deactivate C
B --> A: Display search results
deactivate B

'====================================
' Alternative / Exceptional Flow
'====================================
== Alternate / Exception Flow: No Results Found ==
A -> B: Enter search query (query: string)
activate B
B -> C: searchProduct(query: string): Product[]
activate C
C -> E: searchProduct(query: string): Product[]
activate E
E --> C: return [] (empty array)
deactivate E
C --> B: return [] (empty array)
deactivate C
B --> A: Display "No products found" message
deactivate B

@enduml

