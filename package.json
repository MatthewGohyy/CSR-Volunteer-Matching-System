{
  "name": "csr-volunteer-matching-system",
  "version": "1.0.0",
  "description": "A comprehensive CSR Volunteer Matching System for connecting volunteers with opportunities",
  "main": "server/dist/server.js",
  "scripts": {
    "dev": "concurrently \"npm run server\" \"npm run client\"",
    "server": "cd server && npm run dev",
    "client": "cd client && npm start",
    "build": "cd client && npm run build",
    "install-all": "npm install && cd server && npm install && cd ../client && npm install",
    "test": "cd client && npm test",
    "lint": "cd client && npm run lint",
    "format": "prettier --write \"**/*.{js,jsx,ts,tsx,json,css,md}\""
  },
  "keywords": [
    "csr",
    "volunteer",
    "matching",
    "react",
    "nodejs",
    "social-impact"
  ],
  "author": "CSIT314 Group Project",
  "license": "MIT",
  "devDependencies": {
    "concurrently": "^8.2.2",
    "prettier": "^3.1.0"
  },
  "engines": {
    "node": ">=18.0.0",
    "npm": ">=8.0.0"
  }
}
